<UserControl x:Class="FaceDiff.Views.ImageSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FaceDiff.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="BaseThumbTemplate">
            <Border Style="{StaticResource ThumbnailItem}"
                    Cursor="Hand"
                    controls:LazyThumbnail.Enable="True"
                    BorderBrush="{Binding HighlightColor, Converter={StaticResource ColorToBrush}}"
                    MouseEnter="BaseImage_MouseEnter"
                    MouseLeave="BaseImage_MouseLeave">
                <StackPanel Margin="4">
                    <Image Source="{Binding Thumbnail}" Height="100"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                    <TextBlock Text="{Binding FileName}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="10" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding MatchedComparisons.Count, StringFormat='({0} matched)'}"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="9" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ComparisonThumbTemplate">
            <Border BorderBrush="{Binding HighlightColor, Converter={StaticResource ColorToBrush}}"
                    Background="{Binding HighlightColor, Converter={StaticResource ColorToBrush}, ConverterParameter=0.15}"
                    controls:LazyThumbnail.Enable="True">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ThumbnailItem}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                <Setter Property="Opacity" Value="0.25" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Margin="4">
                    <Image Source="{Binding Thumbnail}" Height="100"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                    <TextBlock Text="{Binding FileName}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="10" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="VirtualThumbList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWrapPanel ItemWidth="138" ItemHeight="158" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="260" MinWidth="220" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Base Images" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="Folder Path" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..."
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding BrowseBaseFolderCommand}"
                                Margin="8,0,0,0" />
                        <TextBox Text="{Binding BaseFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="Preview: " /><Run Text="{Binding BaseFolderPathPreview, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="File Name Filter (regex)" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Apply"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding ApplyFilterCommand}"
                                Margin="8,0,0,0" MinWidth="60" />
                        <TextBox Text="{Binding BaseFilter, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="FilterTextBox_KeyDown" />
                    </DockPanel>
                    <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="Preview: " /><Run Text="{Binding BaseFilterPreview, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Comparison Images" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="Folder Path" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..."
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding BrowseComparisonFolderCommand}"
                                Margin="8,0,0,0" />
                        <TextBox Text="{Binding ComparisonFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="Preview: " /><Run Text="{Binding ComparisonFolderPathPreview, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="Regex Pattern (capture group for matching)"
                               Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Apply"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding ApplyRegexCommand}"
                                Margin="8,0,0,0" MinWidth="60" />
                        <TextBox Text="{Binding RegexPattern, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"
                                 KeyDown="RegexTextBox_KeyDown" />
                    </DockPanel>
                    <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0" FontFamily="Consolas">
                        <Run Text="Preview: " /><Run Text="{Binding RegexPatternPreview, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="1" Margin="0,0,0,8"
                       Visibility="{Binding IsLoadingImages, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Top" Text="{Binding LoadStatusText}"
                           Foreground="{StaticResource TextDimBrush}" FontSize="12"
                           Margin="0,0,0,4" />
                <ProgressBar Minimum="0"
                             Maximum="{Binding LoadTotal, Mode=OneWay}"
                             Value="{Binding LoadProgress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsLoadIndeterminate, Mode=OneWay}"
                             Height="8" />
            </DockPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8"
                        Visibility="{Binding IsFolderMode, Converter={StaticResource BoolToVis}}">
                <Button Content="Enable all categories" Style="{StaticResource PrimaryButton}"
                        FontSize="11" Padding="10,4" Margin="0,0,6,0"
                        Command="{Binding EnableAllCategoriesCommand}" />
                <Button Content="Disable all categories" Style="{StaticResource DangerButton}"
                        FontSize="11" Padding="10,4"
                        Command="{Binding DisableAllCategoriesCommand}" />
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Base panel -->
                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}">
                            <Run Text="Base Images (" /><Run Text="{Binding BaseImageCount, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>

                        <ListBox Grid.Row="1"
                                 Style="{StaticResource VirtualThumbList}"
                                 ItemsSource="{Binding BaseImages}"
                                 ItemTemplate="{StaticResource BaseThumbTemplate}"
                                 Visibility="{Binding IsFlatMode, Converter={StaticResource BoolToVis}}" />

                        <ListBox Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding IsFolderMode, Converter={StaticResource BoolToVis}}"
                                 ItemsSource="{Binding Categories}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                                          ToolTip="Include this folder category in later steps" />
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text=" (" />
                                                    <Run Text="{Binding BaseCount, Mode=OneWay}" />
                                                    <Run Text=", " />
                                                    <Run Text="{Binding MatchCount, Mode=OneWay}" />
                                                    <Run Text=" matched)" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Expander.Header>
                                        <ListBox Style="{StaticResource VirtualThumbList}"
                                                 Height="360"
                                                 ItemsSource="{Binding DisplayBaseImages}"
                                                 ItemTemplate="{StaticResource BaseThumbTemplate}" />
                                    </Expander>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Comparison panel -->
                <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}">
                            <Run Text="Comparison Images (" /><Run Text="{Binding ComparisonImageCount, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>

                        <ListBox Grid.Row="1"
                                 Style="{StaticResource VirtualThumbList}"
                                 ItemsSource="{Binding ComparisonImages}"
                                 ItemTemplate="{StaticResource ComparisonThumbTemplate}"
                                 Visibility="{Binding IsFlatMode, Converter={StaticResource BoolToVis}}" />

                        <ListBox Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding IsFolderMode, Converter={StaticResource BoolToVis}}"
                                 ItemsSource="{Binding Categories}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                                          ToolTip="Include this folder category in later steps" />
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text=" (" />
                                                    <Run Text="{Binding ComparisonCount, Mode=OneWay}" />
                                                    <Run Text=")" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Expander.Header>
                                        <ListBox Style="{StaticResource VirtualThumbList}"
                                                 Height="360"
                                                 ItemsSource="{Binding DisplayComparisonImages}"
                                                 ItemTemplate="{StaticResource ComparisonThumbTemplate}" />
                                    </Expander>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="8" Background="{StaticResource SurfaceLightBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Parameters" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Use {{name}} placeholders in paths and patterns above. Set a value to FOLDER:&lt;path&gt; to load each subfolder as a category. Categories start collapsed — expand to browse thumbnails."
                               Foreground="{StaticResource TextDimBrush}" FontSize="10" TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding ParameterRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Margin="0,0,4,0"
                                                 Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas" FontSize="11" />
                                        <Button Grid.Column="1" Content="×" Style="{StaticResource DangerButton}"
                                                MinWidth="28" Padding="4,2" FontSize="12" VerticalAlignment="Top"
                                                ToolTip="Remove"
                                                Command="{Binding RemoveCommand}" />
                                    </Grid>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Add parameter" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Margin="0,4,0,0" FontSize="11"
                            Command="{Binding AddParameterCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
